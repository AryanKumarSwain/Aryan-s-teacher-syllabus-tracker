NODE_ENV=development
PORT=4000
DATABASE_URL="mysql://root:password@localhost:3307/school_syllabus_saas"
JWT_SECRET=your-super-secret-jwt-access-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# Email — SMTP is preferred; Resend API is used when SMTP_HOST is unset
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# secure is auto-set: port 465 → true, port 587 → false (STARTTLS)
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_EMAIL=School Syllabus Tracker <your-email@gmail.com>

# Optional Resend fallback (if SMTP_HOST is not set)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=School Syllabus Tracker <onboarding@resend.dev>
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
