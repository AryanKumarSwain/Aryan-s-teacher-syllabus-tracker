generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id              String            @id @default(uuid()) @db.VarChar(50)
  email           String            @unique @db.VarChar(191)
  passwordHash    String            @map("password_hash")
  name            String
  role            UserRole
  schoolId        String?           @map("school_id") @db.VarChar(50)
  avatar          String?
  phone           String?
  status          UserStatus        @default(ACTIVE)
  lastLoginAt     DateTime?         @map("last_login_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  deletedAt       DateTime?         @map("deleted_at")
  activityLogs    ActivityLog[]
  auditLogs       AuditLog[]        @relation("AuditActor")
  chapterProgress ChapterProgress[] @relation("ProgressUpdatedBy")
  notifications   Notification[]
  refreshTokens   RefreshToken[]
  teacher         Teacher?
  topicProgress   TopicProgress[]   @relation("TopicProgressUpdatedBy")
  school          School?           @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@index([role])
  @@index([email])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.VarChar(50)
  userId    String    @map("user_id") @db.VarChar(50)
  tokenHash String    @unique @map("token_hash") @db.VarChar(191)
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model School {
  id                       String            @id @default(uuid()) @db.VarChar(50)
  name                     String
  slug                     String            @unique @db.VarChar(191)
  email                    String
  phone                    String?
  address                  String?
  logo                     String?
  status                   SchoolStatus      @default(ACTIVE)
  currentAcademicSessionId String?           @map("current_academic_session_id") @db.VarChar(50)
  createdAt                DateTime          @default(now()) @map("created_at")
  updatedAt                DateTime          @updatedAt @map("updated_at")
  deletedAt                DateTime?         @map("deleted_at")
  academicSessions         AcademicSession[]
  academicTerms            AcademicTerm[]
  activityLogs             ActivityLog[]
  auditLogs                AuditLog[]
  chapters                 Chapter[]
  classes                  Class[]
  notifications            Notification[]
  subjects                 Subject[]
  subscriptions            Subscription[]
  teachers                 Teacher[]
  topics                   Topic[]
  users                    User[]

  @@index([status])
  @@index([slug])
  @@index([currentAcademicSessionId])
  @@map("schools")
}

model AcademicSession {
  id             String         @id @default(uuid()) @db.VarChar(50)
  schoolId       String         @map("school_id") @db.VarChar(50)
  name           String         @db.VarChar(50) // e.g. "2026-27"
  status         SessionStatus  @default(ACTIVE)
  isArchived     Boolean        @default(false) @map("is_archived")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  school         School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicTerms  AcademicTerm[]
  classes        Class[]
  subjects       Subject[]
  chapters       Chapter[]
  topics         Topic[]
  teacherClasses TeacherClass[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([status])
  @@map("academic_sessions")
}

model SubscriptionPlan {
  id           String         @id @default(uuid()) @db.VarChar(50)
  name         String
  slug         String         @unique @db.VarChar(191)
  description  String?        @db.Text
  priceMonthly Decimal        @map("price_monthly") @db.Decimal(10, 2)
  priceYearly  Decimal        @map("price_yearly") @db.Decimal(10, 2)
  teacherLimit Int            @map("teacher_limit")
  features     Json
  isActive     Boolean        @default(true) @map("is_active")
  sortOrder    Int            @default(0) @map("sort_order")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  deletedAt    DateTime?      @map("deleted_at")
  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id        String             @id @default(uuid()) @db.VarChar(50)
  schoolId  String             @map("school_id") @db.VarChar(50)
  planId    String             @map("plan_id") @db.VarChar(50)
  status    SubscriptionStatus @default(TRIAL)
  startDate DateTime           @map("start_date")
  endDate   DateTime           @map("end_date")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  plan      SubscriptionPlan   @relation(fields: [planId], references: [id])
  school    School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([status])
  @@index([schoolId, status])
  @@index([planId], map: "subscriptions_plan_id_fkey")
  @@map("subscriptions")
}

model Teacher {
  id              String            @id @default(uuid()) @db.VarChar(50)
  schoolId        String            @map("school_id") @db.VarChar(50)
  userId          String            @unique @map("user_id") @db.VarChar(50)
  status          UserStatus        @default(ACTIVE)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  deletedAt       DateTime?         @map("deleted_at")
  chapterProgress ChapterProgress[]
  teacherClasses  TeacherClass[]
  school          School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicProgress   TopicProgress[]

  @@unique([schoolId, userId])
  @@index([schoolId])
  @@index([schoolId, status])
  @@map("teachers")
}

model Class {
  id                String          @id @default(uuid()) @db.VarChar(50)
  schoolId          String          @map("school_id") @db.VarChar(50)
  academicSessionId String          @map("academic_session_id") @db.VarChar(50)
  name              String          @db.VarChar(100)
  grade             String?         @db.VarChar(50)
  section           String?         @db.VarChar(50)
  description       String?         @db.Text
  sortOrder         Int             @default(0) @map("sort_order")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  deletedAt         DateTime?       @map("deleted_at")
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  chapters          Chapter[]
  school            School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subjects          Subject[]
  teacherClasses    TeacherClass[]

  @@unique([schoolId, academicSessionId, name, section])
  @@index([schoolId])
  @@index([academicSessionId])
  @@index([schoolId, deletedAt])
  @@map("classes")
}

model Subject {
  id                String          @id @default(uuid()) @db.VarChar(50)
  schoolId          String          @map("school_id") @db.VarChar(50)
  academicSessionId String          @map("academic_session_id") @db.VarChar(50)
  classId           String?         @map("class_id") @db.VarChar(50)
  name              String          @db.VarChar(100)
  code              String?         @db.VarChar(50)
  description       String?         @db.Text
  color             String?         @db.VarChar(50)
  sortOrder         Int             @default(0) @map("sort_order")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  deletedAt         DateTime?       @map("deleted_at")
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  chapters          Chapter[]
  class             Class?          @relation(fields: [classId], references: [id], onDelete: Cascade)
  school            School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherClasses    TeacherClass[]

  @@unique([schoolId, academicSessionId, classId, name])
  @@index([schoolId])
  @@index([academicSessionId])
  @@index([classId])
  @@map("subjects")
}

model Chapter {
  id                    String            @id @default(uuid()) @db.VarChar(50)
  schoolId              String            @map("school_id") @db.VarChar(50)
  academicSessionId     String            @map("academic_session_id") @db.VarChar(50)
  subjectId             String            @map("subject_id") @db.VarChar(50)
  classId               String            @map("class_id") @db.VarChar(50)
  title                 String            @db.VarChar(191)
  description           String?           @db.Text
  notes                 String?           @db.LongText
  estimatedTeachingDays Int?              @default(0) @map("estimated_teaching_days")
  sortOrder             Int               @default(0) @map("sort_order")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  deletedAt             DateTime?         @map("deleted_at")
  academicSession       AcademicSession   @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  chapterProgress       ChapterProgress[]
  class                 Class             @relation(fields: [classId], references: [id], onDelete: Cascade)
  school                School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject               Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topics                Topic[]

  @@index([schoolId])
  @@index([academicSessionId])
  @@index([subjectId])
  @@index([classId])
  @@index([schoolId, subjectId])
  @@map("chapters")
}

model Topic {
  id                String          @id @default(uuid()) @db.VarChar(50)
  schoolId          String          @map("school_id") @db.VarChar(50)
  academicSessionId String          @map("academic_session_id") @db.VarChar(50)
  chapterId         String          @map("chapter_id") @db.VarChar(50)
  title             String          @db.VarChar(191)
  description       String?         @db.Text
  notes             String?         @db.LongText
  sortOrder         Int             @default(0) @map("sort_order")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  deletedAt         DateTime?       @map("deleted_at")
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  topicProgress     TopicProgress[]
  chapter           Chapter         @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  school            School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([academicSessionId])
  @@index([chapterId])
  @@map("topics")
}

model TeacherClass {
  id                String          @id @default(uuid()) @db.VarChar(50)
  schoolId          String          @map("school_id") @db.VarChar(50)
  academicSessionId String          @map("academic_session_id") @db.VarChar(50)
  teacherId         String          @map("teacher_id") @db.VarChar(50)
  classId           String          @map("class_id") @db.VarChar(50)
  subjectId         String?         @map("subject_id") @db.VarChar(50)
  createdAt         DateTime        @default(now()) @map("created_at")
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  class             Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject           Subject?        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher           Teacher         @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, classId, subjectId, schoolId, academicSessionId])
  @@index([schoolId])
  @@index([academicSessionId])
  @@index([teacherId])
  @@index([classId])
  @@index([subjectId])
  @@map("teacher_classes")
}

model ChapterProgress {
  id                   String                @id @default(uuid()) @db.VarChar(50)
  schoolId             String                @map("school_id") @db.VarChar(50)
  chapterId            String                @map("chapter_id") @db.VarChar(50)
  teacherId            String                @map("teacher_id") @db.VarChar(50)
  teachingCompleted    Boolean               @default(false) @map("teaching_completed")
  qaCompleted          Boolean               @default(false) @map("qa_completed")
  copyChecked          Boolean               @default(false) @map("copy_checked")
  chapterStatus        ChapterWorkflowStatus @default(PENDING) @map("chapter_status")
  completionPercentage Int                   @default(0) @map("completion_percentage")
  completedAt          DateTime?             @map("completed_at")
  updatedById          String?               @map("updated_by") @db.VarChar(50)
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  chapter              Chapter               @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  teacher              Teacher               @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  updatedBy            User?                 @relation("ProgressUpdatedBy", fields: [updatedById], references: [id])

  @@unique([schoolId, chapterId, teacherId])
  @@index([schoolId])
  @@index([teacherId])
  @@index([chapterId])
  @@index([schoolId, chapterStatus])
  @@index([updatedById], map: "chapter_progress_updated_by_fkey")
  @@map("chapter_progress")
}

model TopicProgress {
  id          String      @id @default(uuid()) @db.VarChar(50)
  schoolId    String      @map("school_id") @db.VarChar(50)
  topicId     String      @map("topic_id") @db.VarChar(50)
  teacherId   String      @map("teacher_id") @db.VarChar(50)
  status      TopicStatus @default(PENDING)
  completedAt DateTime?   @map("completed_at")
  updatedById String?     @map("updated_by") @db.VarChar(50)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  teacher     Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  topic       Topic       @relation(fields: [topicId], references: [id], onDelete: Cascade)
  updatedBy   User?       @relation("TopicProgressUpdatedBy", fields: [updatedById], references: [id])

  @@unique([schoolId, topicId, teacherId])
  @@index([schoolId])
  @@index([teacherId])
  @@index([topicId], map: "topic_progress_topic_id_fkey")
  @@index([updatedById], map: "topic_progress_updated_by_fkey")
  @@map("topic_progress")
}

model Notification {
  id        String           @id @default(uuid()) @db.VarChar(50)
  schoolId  String?          @map("school_id") @db.VarChar(50)
  userId    String           @map("user_id") @db.VarChar(50)
  title     String
  message   String           @db.Text
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false) @map("is_read")
  metadata  Json?
  createdAt DateTime         @default(now()) @map("created_at")
  school    School?          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([schoolId])
  @@map("notifications")
}

model ActivityLog {
  id         String   @id @default(uuid()) @db.VarChar(50)
  schoolId   String?  @map("school_id") @db.VarChar(50)
  userId     String   @map("user_id") @db.VarChar(50)
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id") @db.VarChar(50)
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")
  school     School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
  @@index([userId])
  @@index([entityType, entityId])
  @@map("activity_logs")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.VarChar(50)
  schoolId   String?  @map("school_id") @db.VarChar(50)
  actorId    String   @map("actor_id") @db.VarChar(50)
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id") @db.VarChar(50)
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")
  actor      User     @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  school     School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
  @@index([actorId])
  @@map("audit_logs")
}

model AcademicTerm {
  id                  String             @id @default(uuid()) @db.VarChar(50)
  schoolId            String             @map("school_id") @db.VarChar(50)
  academicSessionId   String             @map("academic_session_id") @db.VarChar(50)
  name                String             @db.VarChar(100)
  startDate           DateTime           @map("start_date")
  endDate             DateTime           @map("end_date")
  totalWorkingDays    Int                @map("total_working_days")
  actualAvailableDays Int                @map("actual_available_days")
  weeklyHolidays      Json
  status              AcademicTermStatus @default(ACTIVE)
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  deletedAt           DateTime?          @map("deleted_at")
  academicSession     AcademicSession    @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  school              School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  vacationDays        VacationDay[]
  terms               Json               @default("[]")

  @@unique([schoolId, academicSessionId])
  @@index([schoolId])
  @@index([academicSessionId])
  @@index([status])
  @@map("academic_terms")
}

model VacationDay {
  id             String       @id @default(uuid()) @db.VarChar(50)
  academicTermId String       @map("academic_term_id") @db.VarChar(50)
  startDate      DateTime     @map("start_date") @db.Date
  endDate        DateTime     @map("end_date") @db.Date
  reason         String?      @db.Text
  createdAt      DateTime     @default(now()) @map("created_at")
  academicTerm   AcademicTerm @relation(fields: [academicTermId], references: [id], onDelete: Cascade)

  @@index([academicTermId])
  @@index([startDate])
  @@map("vacation_days")
}

enum UserRole {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SchoolStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  TRIAL
}

enum ChapterWorkflowStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum TopicStatus {
  PENDING
  COMPLETED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum AcademicTermStatus {
  ACTIVE
  UPCOMING
  COMPLETED
  ARCHIVED
}

enum SessionStatus {
  ACTIVE
  ARCHIVED
}